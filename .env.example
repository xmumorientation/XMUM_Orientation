# ── Supabase ─────────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Used by admin API routes (CSV user import,
# NFC token generation). Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NFC token signing ────────────────────────────────────────────────────
# Random 32+ byte secret used to HMAC-sign one-time NFC activation tokens.
# Generate with: openssl rand -hex 32
NFC_TOKEN_SECRET=change-me-to-a-long-random-secret

# ── Group Homepage pass (signed cookie) ──────────────────────────────────
# HMAC secret for wristband/ticket redeem → httpOnly group pass cookie.
# Generate with: openssl rand -hex 32
# In development only, a fixed local fallback is used if unset.
GROUP_PASS_SECRET=change-me-to-a-long-random-secret

# Pass lifetime in seconds (default 43200 = 12 hours). Min 60, max 7 days.
# GROUP_PASS_TTL_SECONDS=43200

# Optional admin key for POST /api/group-pass/rotate (header x-group-pass-key).
# In non-production, rotate is allowed without a key if this is unset.
# GROUP_PASS_ADMIN_KEY=

# Demo fake codes (DEMO-GROUP-1, DEMO-GROUP-3). Default OFF.
# Set to true only for local/preview walkthroughs — never in production.
# Freshie Login accepts these when the flag is on (DEMO-GROUP-1 → /group/demo-1).
# ENABLE_DEMO_GROUP_CODES=false

# Freshie Login group passwords. Comma-separated password:groupId[:version].
# Entering a password on /login/freshie opens that group's dashboard.
# Example: GROUP_PASSWORDS=night-ticket:demo-1,orion-ticket:demo-3
# GROUP_PASSWORDS=

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL, used when generating NFC sticker URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
