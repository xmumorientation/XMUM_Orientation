# ── Supabase ─────────────────────────────────────────────────────────────
# Get these from Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Used by admin API routes (CSV user import,
# NFC token generation). Never expose to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NFC token signing ────────────────────────────────────────────────────
# Random 32+ byte secret used to HMAC-sign one-time NFC activation tokens.
# Generate with: openssl rand -hex 32
NFC_TOKEN_SECRET=change-me-to-a-long-random-secret

# ── App ──────────────────────────────────────────────────────────────────
# Public base URL, used when generating NFC sticker URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
